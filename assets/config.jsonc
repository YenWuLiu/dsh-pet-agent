// DSH-PET-AGENT 配置（JSONC：允许 // 和 /* */ 注释）
// 说明：浏览器端启动时通过 /dsh-pet-7340/config.jsonc 拉取；任何字段缺失/写错都会
//       在加载层显式报错（控制台可见），不做静默兜底——配置是完整的事实来源。
//
// ============================ 本项目的素材状态 ============================
// assets/webm/ 现有 14 条自制动画（手抠带 alpha 的 MOV 母版，经 scripts/normalize-webm.py
// 归一化成 640×360 VP9-Alpha）。本文件**只引用这 14 条**：配置里出现的每个名字都有对应
// webm 文件；没出片的槽位一律不写进池子（写了就是空播，check-assets.ps1 也会报「缺 webm」）。
// 还没出片的 92 个槽位名集中列在**文件末尾**的注释块里——出片后把名字挪进对应池子即可。
//   出片（手抠 MOV 母版或 key-video.py 自动抠像）→ 归一化：
//     python scripts/normalize-webm.py <源目录> assets/webm --anchor 待机呼吸休闲
//   → 验收：.\scripts\check-assets.ps1（配置↔素材齐备 + 640×360/alpha + 锚点契约）
//
// 引擎契约要点（改这个文件前务必遵守，否则渲染端会静默失败）：
//   idle 必须非空；turn / drag / clicks 必须存在（可为空数组——空池都是安全的：转向档位
//     落回小动作池、拖拽只走物理跟手不播专门动画、点按只做 Q 弹挤压反馈）；
//   moves 必须有 default 对象和 actions 数组（actions 为空 → tryMove 返回 false，落回小动作池）；
//   events 每个值都要是非空字符串数组，**段本身可以是空对象**（本项目三组事件动画都还没出片，
//     所以写 {}）。注意：覆盖层（main-config.json / pet/<名>-config.json）若自己写 animations，
//     宿主校验仍要求 events.balance 非空（见 src/vendor/config.ts 的 animationsValid）；
//   animationWeights 的 idle / turn / move 必须齐全；三者之和 <100 才有小动作池，
//   且各分类 weight 合计 = 100 − idle − turn − move（当前 10 + 0 + 5 = 15，分类合计 85）。
//
// 与 DSH-PET 的唯一差异：pets[0] 的碎碎念 / 工作状态开关**先关着**——这两组动画
// （碎碎念 3 条 + 工作状态 6 条）还没出片；出片后改 true 并把名字填进 animations.events。
{
  // ===================== 碎碎念（系统提示词人设，全局唯一，所有启用碎碎念的宠物共用） =====================
  // 宠物开启碎碎念（pets[].whisperEnabled = true）时，按 eventsRefreshSec.whisper 周期
  // 用此提示词调用当前服务商生成一句话，气泡显示。说人话、不啰嗦、不解释自己、不提 AI。
  "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），温柔乖巧带点俏皮，说人话不啰嗦，不要解释你自己，不要提你是AI。",
  // ===================== 对话记忆轮数（全局默认；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 右键菜单「对话」弹窗与桌宠聊天时，每次请求携带的最近历史轮数（1 轮 = 1 问 1 答）。
  // memory.json 全存不删，此值只决定"每次请求截取多少进上下文"。非负数字；缺失默认 5，
  // 写了非法（负数/非数字）即配置错误。回落链同 whisperPrompt：种类文件顶层 → 全局 → 默认 5。
  "chatMemoryRounds": 5,
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹出系统级通知（桌面右下角）。
  // 不需要时改为 false（修改后刷新或重启生效）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.json）顶层覆盖，设置页保存宠物时会保留该字段。
  "notificationsEnabled": true,
  // ===================== 工作状态联动文案（条目级，与 animations/physics 同级；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 工作状态气泡文本（pets[].workStatusEnabled 开启时展示；仅在 events.workStatus 动画触发时弹）。
  // 结构 = 二维数组，外层索引即档位（与 events.workStatus 动画索引一一对应，勿在中间插入新档）：
  //   0 thinking（turn/start）/ 1 working（tool/call）/ 2 result（tool/result）/
  //   3 waiting（approval/asked）/ 4 success（turn/end completed）/ 5 error（turn/end error/max-tokens）
  // 每档内是多个备选句，播放时随机抽一句（想固定单句就只写一个；想换文案只改这里）。
  // 省略整个字段 = 不弹工作状态气泡文本（仍播动画）；省略某档 = 该档不显示文本。
  // 现状：文案先留着，等 events.workStatus 那 6 条动画出片、开关打开后即生效。
  "workStatusTexts": [
    ["正在认真想下一步呢", "让我整理一下思路~", "正在梳理接下来要做什么"],
    ["正在处理任务呢", "这一步正在进行中哦", "正在继续干活呢，别打扰我~"],
    ["这一步处理好啦，接着看下一步", "搞定一步，继续看看哦~"],
    ["需要你确认一下呢", "这里要等你看一下哦", "轮到你来决定啦，等你~"],
    ["这一轮搞定啦，真棒！", "任务完成咯，可以摸鱼啦~"],
    ["这一步好像没跑通呢", "刚才的操作遇到点问题哦", "这里卡了一下，再等等你呢"]
  ],
  // ===================== 宠物物理（拖拽抛掷手感，全局，所有宠物共用） =====================
  // gravity：抛掷下落/反弹的基础重力（px/s²）。默认 1400（数值越大落得越快）；0 = 无重力（合法，
  //   抛掷后匀速直线飞行/永不回落，配合 restitution/groundFriction=0 即纯无重力漂浮）。
  // restitution：碰壁反弹恢复系数，0~1（1 = 完全弹性，0 = 撞上即停；墙/地共用）。默认 0.78。
  // groundFriction：落地时水平速度的衰减率（/s，0 = 无摩擦冰面）。默认 2.5。
  // ceilingBounce：顶部是否反弹。true = 碰顶反弹（现状）；false = 顶部无边界，
  //   抛掷可飞出屏幕顶部（超出可视区域，重力仍会拉回落）。默认 true。
  // throwPower：总力度（拖拽/抛掷输出增益）。弹簧跟手（K/C）、甩抛初速与软上限 3600 整体 ×p：
  //   1.0 = 现状；>1 = 跟手更贴、甩得更猛、可达到的上限更高；<1 = 松弛、更易温柔放下。必须 > 0。
  // petCollision：多宠物互相碰撞开关。true = 飞行中被甩出的宠物撞到其它宠物时，
  //   按动量守恒 + 恢复系数 0.995 弹开（质量 ∝ size²）；false = 关闭（默认，宠物互相穿过）。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // ===================== 默认宠物列表（多开） =====================
  // pets 数组定义默认宠物；「设置页 → 添加宠物」的默认模板取 pets[0]（main）。
  // 每个宠物独立：name（显示名，可重复：悬浮提示 / AI 人设追加「你的名字是X」/ 未来命令行定位的
  //   显示层。可省略——缺失或留空按该宠物 id 处理并告警，兼容旧配置）、
  // id（唯一标识，程序定位用：素材/记忆/端点参数都按它，绝不重叠，冲突即配置错误）、
  // size（宽度 px，高度自动 = size × 9/16）、
  // balanceEnabled（余额功能开关：必填布尔值，缺失即配置错误。余额查询功能已按要求移除，
  //   渲染端不再读该字段——保留它只为兼容旧配置与配置校验）、display（显示位置，必填四值之一：
  //   web=仅浏览器 overlay / desktop=仅桌面模式（Electron 透明窗）/ both=两者/ none=都不显示。
  //   缺失按默认 both 处理并告警（兼容 ≤0.2.0 旧配置），写了非法值即配置错误；桌面模式渲染
  //   display 含 desktop/both 的全部宠物，每只一个局部小窗）、
  // position（corner: 四角之一；marginX/marginY: 距所属角落偏移 px）
  "pets": [
    {
      "name": "蓝毛小女仆",
      "id": "main",
      "size": 462,
      // 余额查询功能已按要求去掉——宿主不再提供 /balance、渲染端不再轮询与弹气泡；
      // 该字段只为兼容旧配置与配置校验而保留。
      "balanceEnabled": false,
      // 碎碎念开启：按 eventsRefreshSec.whisper（默认 300s）周期性调一次当前对话模型生成
      // 一句话 + 播碎碎念动画。想省额度/不想后台调用模型就改回 false。
      // 现状 false：events.whisper 那 3 条动画还没出片（出片后改 true 并填名字）。
      "whisperEnabled": false,
      // 工作状态联动：监听本体会话事件（工具调用等），按 animations.events.workStatus
      // 数组切档位动画 + 气泡（仅监听，不调用模型）。
      // 现状 false：events.workStatus 那 6 条动画还没出片（出片后改 true 并填名字）。
      "workStatusEnabled": false,
      "display": "both",
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],

  // ===================== 动作动画池配置 =====================
  "animations": {
    // 待机动画池（数组，可放多个，等概率抽）：唯一的常驻动画，必须非空。
    // 待机呼吸休闲 = 10.07s / 302 帧，循环播放（实测首尾接缝差 0.87 ≈ 常规帧间差的 5.6 倍，
    // 是硬接；两端姿势目视几乎一致，暂不另做无缝段——见 docs/动画生成清单.md 第 7 节判据）。
    "idle": ["待机呼吸休闲"],
    // 转向动画池：**空** —— 还没有「播完会翻转朝向」的动画（东张西望未出片）。
    // 空池安全：转向档位自动落回小动作池，所以 animationWeights.turn 相应给 0。
    "turn": [],
    // 拖拽动画池：**空** —— 还没有「被无形之手拎起悬空」的姿势（被鼠标拖拽悬空反馈未出片）。
    // 空池安全：拖拽只走物理跟手（弹簧跟随 + 甩抛），不播专门动画。
    "drag": [],
    // 点击回应动画池：**空** —— 5 条点击回应都还没出片。
    // 空池安全：点按只做 Q 弹挤压反馈（不播动画、不报错）。
    "clicks": [],
    // 移动动画池：default 是每个动作都用的默认参数；actions 里每项可覆盖部分参数，
    // 未写的字段取 default。minDist/maxDist=单次行进距离(px)——以「基准宠物宽 462px」为准，
    //   运行时按 实际size/462 等比缩放（小宠物挪小步、大宠物挪大步，与人物大小匹配）；
    // margin=贴边安全距(px，不随缩放)、leadSec/tailSec=动画首尾各多少秒原地不动。
    // 实测（2026-09-22）：只有 螃蟹走路 适合做漫游——片内角色几乎原地踏步（10s 内横向摆动
    //   仅 27px），配合「窗口平移」就是横向走路；首尾静止段实测 0.57s / 0.20s，按实测填。
    // 原地左转奔跑 **不在这里**：它片内横向位移 100px、含躺倒翻滚，是原地动作，已放进「玩耍」。
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 0.57, "tailSec": 0.2 },
      "actions": [
        { "name": "螃蟹走路" }
      ]
    },
    // 随机动作：分类池。weight 为该分类出现权重；noMirror: true 表示「带文字、镜像会颠倒，
    // 宠物面向右（被镜像）时不播放该类」。所有分类 weight 合计应与 animationWeights 里
    // 顶层权重和的余量（100 − idle − turn − move = 85）相等。
    // 分类名沿用上游那套（小动作 / 玩耍 / 吃什么 / 时节 / 文字），出片后按类归位即可。
    "categories": [
      { "id": "小动作", "weight": 30, "actions": [
        "悠闲哼歌", "偷吃零食被抓住", "打瞌睡被惊醒", "整体换装试色"
      ] },
      { "id": "玩耍", "weight": 40, "actions": [
        "优雅女仆舞", "可爱宅舞", "轻快摇摆舞", "小提琴演奏", "撸猫", "鲸鱼吐泡泡特效",
        "原地左转奔跑"
      ] },
      { "id": "吃什么", "weight": 15, "actions": [
        "大口吃零食"
      ] }
    ],
    // 事件动画：不进随机链（rollKind/pickNext 不会抽到），只由代码显式触发。
    // events.<事件名> 为动画名数组，按「事件档位」顺序排列（索引即档位）。
    // **当前为空对象**：balance 6 条 / whisper 3 条 / workStatus 6 条都还没出片。
    // 出片后按下面的档位语义填回来（名字见文件末尾名单）：
    //   balance（余额展示，按已用百分比分档）index = p === 100 ? 5 : Math.floor(p / 20)；
    //   whisper（碎碎念）到点随机抽 1 段；workStatus 索引 = 状态档位（thinking/working/
    //   result/waiting/success/error），新档只可追加到末尾，勿在中间插入。
    "events": {}
  },

  // ===================== 事件触发周期 =====================
  // 事件名 → 刷新间隔（秒）。whisper（碎碎念）：到点随机抽一段播 + 弹气泡。
  // 非法数值（非正数/非数字）即配置错误。
  // balance（余额）：**已停用**——余额查询整体移除后渲染端不再轮询 /balance，这个值留着
  // 只为兼容旧配置与配置校验的必填字段（与 pets[i].balanceEnabled 同一回事）。
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move 的权重 + 上面各分类 weight 合计 = 100
  // 当前：10 + 0 + 5 + (30+40+15=85) = 100。
  // turn = 0 是因为 turn 池为空（没有转向动画，掷到也没有片可播）；出片后给回 5 并把
  // 分类权重相应减到 80。
  "animationWeights": {
    "idle": 10,
    "turn": 0,
    "move": 5
  }
}

// ===================== 待出片槽位名单（92 条；出片后从这里挪进上面的池子） =====================
// 名字即最终 webm 名（assets/webm/<名>.webm）。分组沿用上游动画池的分类。
// turn：东张西望
// drag：被鼠标拖拽悬空反馈
// clicks：点击回应-开心跃动 / 点击回应-害羞惊讶 / 点击回应-傲娇生气 / 点击回应-挠痒咯咯笑 /
//   点击回应-元气挥手
// moves：原地漂浮踏步
// 小动作（14）：超大伸懒腰 / 原地敲击桌面互动 / 原地重力下蹲压缩 / 哈欠连天 / 原地小憩沉眠 /
//   女仆屈膝礼仪 / 被吓一跳 / 小幅度原地360度旋转展示 / 用鲸鱼尾巴拍打地面 / 照镜子 /
//   轻快记录 / 写代码 / 摇扇纳凉 / 晨间刷牙
// 玩耍（21）：原地专心玩魔方 / 原地蹲下玩玩具汽车 / 原地跳跃抓碎头顶物品 / 玩游戏气急败坏 /
//   玩水枪 / 蓝鲸现世 / 吹气球 / 动物环绕 / 放风筝 / 拆礼物 / 变鸽子 / 扑克魔术 / 抽陀螺 /
//   吹笛子 / 蝴蝶蜜蜂环绕头顶开花 / 凭空生花 / 骑木马 / 三球抛接 / 踢毽子 / 下五子棋 / 荡秋千
// 吃什么（11）：吃白饭 / 吃Token / 吃早餐 / 吃午餐 / 吃晚餐 / 吃冰淇淋融化 / 吃大闸蟹 /
//   吃糖葫芦 / 吃长寿面 / 吃西瓜 / 涮火锅
// 时节（21）：被落叶淹没 / 中秋赏月吃月饼 / 堆雪人 / 放烟花 / 吃粽子 / 吃年糕 / 吃青团 /
//   吃腊八粥 / 吃重阳糕 / 收红包 / 写福字 / 穿针乞巧 / 舞狮头 / 讨糖南瓜灯 / 插茱萸赏菊 /
//   放河灯 / 萌化小幽灵 / 装点圣诞树 / 放孔明灯 / 吃汤圆 / 吃饺子
// 文字（2）：是啊，吃什么 / 深度思考碎碎念
// events.balance（6）：余额-钱袋满溢 / 余额-金袋叮当 / 余额-钱袋如常 / 余额-数金皱眉 /
//   余额-袋空如洗 / 余额-分文不剩
// events.whisper（3）：碎碎念-擦桌碎碎念 / 碎碎念-发呆碎碎念 / 碎碎念-对屏碎碎念
// events.workStatus（6）：工作状态-思考冒泡 / 工作状态-忙碌点按 / 工作状态-清点归档 /
//   工作状态-原地踱步张望 / 工作状态-雀跃庆祝 / 工作状态-垂头叹气冒汗
// 备注：被吓一跳.mov 已导出但导出坏了（人物只有 85×81，整片仅 0.5% 不透明像素），需重出；
//   其余 14 条母版在仓库外的 mov/ 目录（D:\dsh-pet-agent\mov\），归一化产物已在 assets/webm/。
