// dsh-pet 配置（JSONC）—— 自制素材 9 动画先行版（核心 7 + 干饭/熟睡）
// 坐姿抱膝/挂右边缘/挂顶边 3 条待生成，到位后加回 categories 并恢复 12 动画制
// （见 assets-custom/CHECKLIST.md 与 CHARACTER.md 第 8 节）。
// 余额/碎碎念/工作状态联动的动画池用占位填充（引擎校验要求 events.* 数组非空），
// 三个功能在 pets[0] 里全部关闭；后续动画池扩充后再启用并替换为真分档。
{
  // 碎碎念人设提示词（启用时生效；当前 whisperEnabled=false）
  "whisperPrompt": "你是主人桌面上的Q版蓝鲸鱼小女仆，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），温柔乖巧带点俏皮，经常想着吃饭，说人话不啰嗦，不要解释你自己，不要提你是AI。",
  "chatMemoryRounds": 5,
  "notificationsEnabled": true,
  // 工作状态气泡文案（当前 workStatusEnabled=false，留作后续启用）
  "workStatusTexts": [
    ["正在认真想下一步呢"],
    ["正在处理任务呢"],
    ["这一步处理好啦"],
    ["需要你确认一下呢"],
    ["这一轮搞定啦！"],
    ["好像卡住了呢"]
  ],
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  "pets": [
    {
      "name": "小蓝",
      "id": "main",
      "size": 462,
      // 三个联动功能默认关闭：对应动画池当前是占位，等动画库扩充后再开
      "balanceEnabled": false,
      "whisperEnabled": false,
      "workStatusEnabled": false,
      "display": "both",
      "position": { "corner": "top-right", "marginX": 24, "marginY": 100 }
    }
  ],

  // ===================== 动作动画池（12 动画制） =====================
  "animations": {
    // 待机（唯一循环播放；首尾帧无缝）
    "idle": ["待机呼吸休闲"],
    // 转向（播完时引擎翻转朝向，动画本身必须「结束时朝向与开头相反」）
    "turn": ["东张西望"],
    // 拖拽（被拎起悬空）
    "drag": ["被鼠标拖拽悬空反馈"],
    // 点击回应（点按时随机抽 1 个）
    "clicks": [
      "点击回应-开心摇尾",
      "点击回应-生气跺脚",
      "点击回应-惊吓跌倒"
    ],
    // 移动（实测：片头 1.5s 静止、片中 5.5s 行走、片尾 0.8s 静止；窗口平移由引擎完成）
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 1.5, "tailSec": 0.8 },
      "actions": [
        { "name": "悠闲散步" }
      ]
    },
    // 随机小动作池（权重 40，与 animationWeights 合计 = 100）
    "categories": [
      { "id": "小动作", "weight": 40, "actions": [
        "趴地熟睡", "跪坐干饭"
      ] }
    ],
    // 事件动画：占位填充（功能已关闭；校验要求非空数组）。扩充后替换为真分档
    "events": {
      "balance": ["跪坐干饭", "跪坐干饭", "跪坐干饭", "跪坐干饭", "跪坐干饭", "跪坐干饭"],
      "whisper": ["趴地熟睡", "跪坐干饭"],
      "workStatus": ["趴地熟睡", "跪坐干饭", "跪坐干饭", "趴地熟睡", "点击回应-开心摇尾", "点击回应-生气跺脚"]
    }
  },

  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // 权重守恒：35 + 5 + 20 + 40 = 100
  "animationWeights": {
    "idle": 35,
    "turn": 5,
    "move": 20
  }
}
