node_modules/
.pnpm-store/
lib/
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db
# 本地工具链：只忽略体积大的二进制；脚本与自检必须进仓库
# （tools/ 曾经整目录被忽略——结果连 tools/chat-smoke 的面板回归都没进版本管理）
tools/*.exe
tools/**/*.exe
tools/*.zip
tools/**/*.zip
# 打包产物与暂存（scripts/pack-exe.ps1 可再生）
dist/
packaging/staging/
packaging/staging-install/

# 本地验证/调研暂存（可再生）
.smoke/
# 冒烟脚本的产出与 Electron 用户目录缓存（每次跑都会重写）
tools/**/out/
.kernel-research/
.stream-research/
.npm-cache-tmp/
.npm-cache-tmp-research/
# 升级内核前的 ~/.dsh 快照：内含本机会话记忆与凭据，绝不入库
.upgrade-backup/

# Python 字节码缓存（import 脚本时生成，非源码）
__pycache__/
*.pyc
