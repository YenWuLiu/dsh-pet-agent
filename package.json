{
  "name": "dsh-pet-standalone",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone desktop pet driven by the DeepSeek Harness kernel packages from npm 鈥?no dsh CLI, no monorepo checkout required",
  "type": "module",
  "scripts": {
    "start": "node lib/bin.js",
    "dev": "node --import tsx/esm src/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-base": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-rc.1",
    "electron": "^33.4.0",
    "koffi": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "allowBuilds": {
      "electron": true,
      "esbuild": true,
      "koffi": true,
      "node-pty": true,
      "@deepseek-ai/dsh-subprocess-local@0.1.2-rc.1": true,
      "@google/genai": false,
      "protobufjs": false
    },
    "patchedDependencies": {
      "node-pty@1.2.0-beta.15": "patches/node-pty@1.2.0-beta.15.patch"
    }
  }
}
