{
  "name": "dsh-pet-agent",
  "version": "0.1.0",
  "private": true,
  "description": "DSH-PET-AGENT — desktop pet driven by the DeepSeek Harness kernel packages from npm (own animation set; no bundled animations)",
  "type": "module",
  "scripts": {
    "start": "node lib/bin.js",
    "dev": "node --import tsx/esm src/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "check:desktop-core": "node scripts/build-desktop-core.mjs --check",
    "check:shell-types": "tsc -p shell/tsconfig.json",
    "verify:shell": "tsc -p shell/tsconfig.json && node scripts/check-think-strip.mjs && node scripts/check-ps1-bom.mjs && node scripts/build-desktop-core.mjs --check && node scripts/inspect-font.mjs --check --expect-family HappyZcool-2016 && node scripts/check-shared-parity.mjs && node scripts/check-menu-clamp.mjs && node scripts/check-chat-placement.mjs && node scripts/check-bubble-schedule.mjs && node scripts/check-pointer-target.mjs && node tools/chat-smoke/panel-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-base": "0.1.5-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "electron": "^33.4.0",
    "koffi": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "allowBuilds": {
      "electron": true,
      "esbuild": true,
      "koffi": true,
      "node-pty": true,
      "@deepseek-ai/dsh-subprocess-local@0.1.5-rc.2": true,
      "@google/genai": false,
      "protobufjs": false
    },
    "patchedDependencies": {
      "node-pty@1.2.0-beta.15": "patches/node-pty@1.2.0-beta.15.patch"
    }
  }
}
